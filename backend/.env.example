# Gemini API key for prompt planning
GEMINI_API_KEY="<ENTER_YOUR_API_KEY>"

# Override device auto-detection (cuda, cpu, mps)
DEVICE=""

# Model paths for local models (optional, will use HF default paths)
MODEL_PATHS='{"sam": "", "diffusion": "", "esrgan": ""}'

# Directories (defaults shown below)
OUTPUT_DIRECTORY="outputs"
UPLOAD_DIRECTORY="uploads"
TEMP_DIRECTORY="temp"

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=10

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=300

# Model cache timeout in minutes
MODEL_CACHE_TIMEOUT_MINUTES=30

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"

# CORS origins (comma-separated)
CORS_ORIGINS="*"
