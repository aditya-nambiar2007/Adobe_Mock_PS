# Gemini API key for prompt planning
GEMINI_API_KEY="<ENTER_YOUR_API_KEY>"

# Gemini model name (default: gemini-3.1-flash-lite)
# GEMINI_MODEL="gemini-3.1-flash-lite"

# Override device auto-detection (cuda, cpu, mps)
# DEVICE=""

# Model paths for local models (optional, will use HF default paths)
# MODEL_PATHS='{"sam": "", "diffusion": "", "esrgan": ""}'

# Directories (defaults shown below)
OUTPUT_DIRECTORY="outputs"
UPLOAD_DIRECTORY="uploads"
TEMP_DIRECTORY="temp"

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=10

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=300

# Model cache timeout in minutes
MODEL_CACHE_TIMEOUT_MINUTES=30

# Path to LoRA adapter weights (.safetensors or directory); auto-applied on diffusion load
# DIFFUSION_LORA_WEIGHTS="/path/to/lora.safetensors"
# DIFFUSION_LORA_ADAPTER_NAME="default"

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"

# CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:5173"
